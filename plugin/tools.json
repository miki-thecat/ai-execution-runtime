{
  "schema_version": "v1",
  "server": "aer",
  "tools": [
    { "name": "project.inspect", "input": { "projectId": "string?", "project": "string?", "budgets": "bounded?" } },
    { "name": "project.resume", "input": { "projectId": "string?", "project": "string?", "eventLimit": "positive integer?", "itemLimit": "positive integer?" } },
    { "name": "file.read", "input": { "projectId": "string?", "path": "string", "maxBytes": "positive integer?" } },
    { "name": "file.search", "input": { "projectId": "string?", "query": "string", "path": "string?", "maxResults": "positive integer?" } },
    { "name": "file.patch", "input": { "projectId": "string?", "path": "string", "expectedHash": "string?", "content": "string?", "patch": "string?" } },
    { "name": "shell.run", "input": { "projectId": "string?", "command": "string", "timeoutMs": "positive integer?", "maxOutputBytes": "positive integer?" } },
    { "name": "verify.run", "input": { "projectId": "string?", "checkNames": "string[]?" } },
    { "name": "github.snapshot", "input": { "projectId": "string?", "issueNumber": "positive integer?", "includeWork": "boolean?" } },
    { "name": "github.wait", "input": { "projectId": "string?", "pullRequest": "positive integer|string", "condition": "checks_terminal|checks_passed?" } },
    { "name": "agent.run", "input": { "projectId": "string?", "title": "string?", "prompt": "string?" } },
    { "name": "device.list", "input": { "budgets": "bounded?" } },
    { "name": "run.inspect", "input": { "runId": "string" } },
    { "name": "run.compare", "input": { "runIds": "string[]" } },
    { "name": "artifact.read", "input": { "ref": "string", "offset": "non-negative integer?", "maxBytes": "non-negative integer?" } }
  ]
}
