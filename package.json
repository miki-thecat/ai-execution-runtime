{
  "name": "@miki-thecat/ai-execution-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "AI Execution Runtime foundation",
  "type": "module",
  "bin": {
    "aer": "src/cli/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "tsc --project tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts test/e2e/*.test.ts",
    "aer": "node --experimental-strip-types src/cli/index.ts",
    "benchmark": "node --experimental-strip-types examples/full-alpha.ts",
    "e2e": "node --experimental-strip-types --test test/e2e/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  }
}
