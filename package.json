{
  "name": "ai-execution-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "A thin, observable local-first runtime for AI computer execution.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsc --outDir dist",
    "dev": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint . --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:local": "node --experimental-strip-types --test test/**/*.test.ts",
    "mcp": "node --experimental-strip-types src/mcp.ts",
    "demo": "node --experimental-strip-types examples/full-alpha.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
